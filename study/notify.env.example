# Copy to ~/.config/marketatlas/notify.env (chmod 600) and fill in.
# Uses matrix-nio with E2EE, so the target room may be encrypted.

MATRIX_HOMESERVER=https://glasgow.social
MATRIX_USER_ID=@moss:glasgow.social
MATRIX_PASSWORD=REPLACE_WITH_ACCOUNT_PASSWORD
MATRIX_ROOM_ID=!REPLACE_WITH_ROOM_ID:glasgow.social

# Optional: where the device/olm store is kept (default below).
# MATRIX_STORE_DIR=/home/scott/.local/share/marketatlas/matrix-store
